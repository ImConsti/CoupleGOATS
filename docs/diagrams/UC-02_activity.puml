
@startuml UC-02_activity

title UC-02 – Tierprofil ansehen\nUML-Aktivitätsdiagramm

skinparam shadowing false
skinparam activity {
  BackgroundColor #F8F9FA
  BorderColor #34495E
  DiamondBackgroundColor #FFF2CC
  DiamondBorderColor #9A7D0A
  StartColor #2E7D32
  EndColor #B71C1C
  BarColor #34495E
}
skinparam ArrowColor #34495E
skinparam defaultFontName Arial
skinparam activityFontSize 12
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #B7950B
}

|Adoptierender|
start
:Discovery-Page öffnen;

|System|
:Veröffentlichte Tierkarten mit den\nwichtigsten Informationen und ggf.\nVorschaubildern anzeigen;

if (Sind veröffentlichte Tierprofile verfügbar?) then ([ja])

  |Adoptierender|
  :Tierkarte auswählen und\nTierprofil aufrufen;

  |System|
  :Detailinformationen des ausgewählten\nTieres beim Backend anfordern;

  if (Ist das Tierprofil noch öffentlich verfügbar?) then ([ja])

    :Veröffentlichungsstatus und\nVoraussetzungen für die öffentliche\nAnzeige des Tierprofils prüfen;

    if (Ist das Tierprofil veröffentlicht\nund für die öffentliche Anzeige geeignet?) then ([ja])

      :Tierprofil, zugehörige Bilder und\nInformationen über das Tierheim ermitteln;

      :Benötigte Tier- und Tierheimdaten\naus der Datenbank abrufen;

      while (Ist der Datenabruf fehlgeschlagen?) is ([ja])

        :Verständliche Fehlermeldung zum\nLaden der Profildaten anzeigen;

        note right
          Alternative 6a:
          Benötigte Daten können aufgrund
          eines technischen Fehlers nicht
          abgerufen oder bereitgestellt werden.
        end note

        |Adoptierender|
        if (Erneuten Ladeversuch starten?) then ([ja])

          |System|
          :Tierprofil- und Tierheimdaten\nerneut beim Backend anfordern;
          :Benötigte Daten erneut aus der\nDatenbank abrufen;

        else ([else])

          :Ladevorgang abbrechen;
          stop

        endif

      endwhile ([nein])

      fork
        :Zugehörige Tierbilder aus dem\nBildspeicher laden;
      fork again
        :Name, Tierart, Rasse, Alter,\nGeschlecht, Tags und Beschreibung\nsowie den Namen des Tierheims bereitstellen;
      end fork

      if (Sind alle angeforderten Bilder verfügbar?) then ([ja])

        :Tierprofil mit den verfügbaren Bildern\nund allen vorgesehenen Informationen anzeigen;

      else ([else])

        :Verfügbare Textinformationen weiterhin anzeigen;
        :Fehlende Bilder durch Platzhalter ersetzen,\nsoweit erforderlich;

        note right
          Alternative 7a:
          Textinformationen sind verfügbar,
          aber einzelne oder alle Bilder
          können nicht geladen werden.
        end note

      endif

      :Navigation zum Profil des zuständigen\nTierheims bereitstellen;

      |Adoptierender|
      if (Möchte der Adoptierende das Tierheimprofil öffnen?) then ([ja])

        :Tierheimprofil aufrufen;

        |System|
        :Öffentliches Tierheimprofil abrufen;

        if (Ist das Tierheimprofil verfügbar\nund öffentlich zugänglich?) then ([ja])

          :Tierheimprofil anzeigen;
          stop

        else ([else])

          :Verständliche Meldung anzeigen,\ndass das Tierheimprofil nicht verfügbar ist;

          note right
            Alternative 8a:
            Das Tierheimprofil kann nicht
            abgerufen werden oder ist
            nicht öffentlich verfügbar.
          end note

          |Adoptierender|
          if (Soll das Tierprofil weiter betrachtet werden?) then ([ja])

            :Tierprofil weiter ansehen;
            stop

          else ([else])

            |System|
            :Discovery-Page erneut anzeigen;
            stop

          endif

        endif

      else ([else])

        |Adoptierender|
        :Tierprofil verlassen, ohne das\nTierheimprofil aufzurufen;

        note right
          Alternative 9a:
          Der Adoptierende verlässt das
          Tierprofil und kehrt zur Discovery-Page zurück.
        end note

        |System|
        :Discovery-Page erneut anzeigen;
        stop

      endif

    else ([else])

      :Öffentliche Bereitstellung der\nProfildaten verweigern;
      :Meldung anzeigen, dass das Tierprofil\nnicht verfügbar ist;

      note right
        Alternative 5a:
        Das Profil ist unveröffentlicht
        oder erfüllt nicht mehr die
        Voraussetzungen für die öffentliche Anzeige.
      end note

      |Adoptierender|
      :Rückkehr zur Discovery-Page auswählen;

      |System|
      :Discovery-Page erneut anzeigen;
      stop

    endif

  else ([else])

    :Keine öffentlich zugänglichen\nProfildaten bereitstellen;
    :Meldung anzeigen, dass das Tierprofil\nnicht mehr verfügbar ist;

    note right
      Alternative 3a:
      Das Tierprofil wurde beispielsweise
      gelöscht oder unveröffentlicht,
      nachdem die Tierkarte angezeigt wurde.
    end note

    |Adoptierender|
    :Rückkehr zur Discovery-Page auswählen;

    |System|
    :Discovery-Page erneut anzeigen;
    stop

  endif

else ([else])

  :Meldung anzeigen, dass keine\nveröffentlichten Tierprofile verfügbar sind;

  note right
    Alternative 2a:
    Es sind keine veröffentlichten
    Tierprofile verfügbar.
  end note

  |Adoptierender|
  :Später erneut nach verfügbaren\nTieren suchen;
  stop

endif

@enduml
