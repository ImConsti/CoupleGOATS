
@startuml components
title CoupleGOATS – UML Component Diagram\nAuthor: Aaron

skinparam componentStyle uml2
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam wrapWidth 200
skinparam maxMessageSize 70
skinparam component {
  BackgroundColor #F5F7FA
  BorderColor #34495E
  FontColor #1F2937
}
skinparam database {
  BackgroundColor #EAF2F8
  BorderColor #34495E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}

left to right direction

actor "Adoptierende /\nTierheim-Mitarbeitende" as User

component "Frontend\n\nNext.js 16\nReact 19\nTypeScript" as Frontend

package "Backend – Node.js 22 / Express 5" {
  component "API & Auth\n\nREST-Routen\nAuthentifizierung\nAutorisierung\nZod-Validierung" as API

  component "Application Services\n\nDiscovery & Swipes\nTierprofile\nInteressen & Termine\nNutzerprofile\nDashboard" as Services

  component "Persistence\n\nRepositories\nDrizzle ORM\nDatenzugriff" as Persistence

  component "Media Handling\n\nFoto-Upload\nFoto-Verwaltung\nPhotoStorageService" as Media
}

database "SQLite\nlibSQL\n\nPersistente Daten\ninkl. Tierbilder" as DB

() "REST API\nHTTPS / JSON\n/api/v1" as IREST
() "Repository-Zugriff\nDrizzle / libSQL" as IDB
() "Foto-Verarbeitung" as IMEDIA

User --> Frontend : Browser / HTTPS

Frontend ..> IREST : benötigt
API - IREST : bietet an

API --> Services : validierte Anfragen
Services --> Persistence : Daten lesen/schreiben
Services --> Media : Fotos verwalten

Persistence ..> IDB : benötigt
DB - IDB : bietet an

Media ..> IMEDIA : interne Funktion
Services ..> IMEDIA : benötigt

note bottom of Frontend
  Browser-Frontend
  Keine direkte DB-Verbindung
end note

note bottom of DB
  Zugriff ausschließlich
  über das Backend
end note

note right of Media
  Bildspeicherung gemäß SRS:
  SQLite-Datei.
  Kein externer Storage-Dienst
  im SRS spezifiziert.
end note

note bottom of Services
  Fachliche Logik aus Task 5
  und den Use Cases UC-01 bis UC-06
end note

legend bottom
  Author: Aaron
  Ball = angebotene Schnittstelle
  Socket = benötigte Schnittstelle
  Externe Services: keine laut SRS 3.9.3
endlegend

@enduml
