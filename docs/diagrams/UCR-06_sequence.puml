@startuml UCR-06_sequence
title UCR-06 – Tierheim Dashboard ansehen

actor "Tierheim-Mitarbeitender" as Employee
boundary ":ShelterDashboardPage" as Page
control ":ShelterDashboardController" as Ctrl
entity ":AnimalShelter" as Shelter
entity ":Animal" as Animal
entity ":AnimalPicture" as Picture
entity ":Interest" as Interest

Employee -> Page : openDashboard()
Page -> Ctrl : getDashboard(token)

Ctrl -> Ctrl : verifyToken(token)

break Token ungültig oder Sitzung abgelaufen
    Ctrl --> Page : unauthenticated
    Page --> Employee : Weiterleitung zum Login
end

break Rolle ist nicht "Tierheim"
    Ctrl --> Page : forbidden
    Page --> Employee : Hinweis, Weiterleitung zur Swipe-Ansicht (UC-01)
end

Ctrl -> Shelter : exists(shelterId)
Shelter --> Ctrl : exists

break Tierheim existiert nicht mehr
    Ctrl --> Page : unauthenticated
    Page --> Employee : Weiterleitung zum Login
end


Ctrl -> Animal : countAnimalsByShelter(shelterId)
Animal --> Ctrl : animalCount
Ctrl -> Interest : countMatchesByShelterId(shelterId)
Interest --> Ctrl : matchCount
Ctrl -> Interest : countOpenRequests(shelterId)
Interest --> Ctrl : openRequestCount
Ctrl -> Interest : countUpcomingMeetings(shelterId)
Interest --> Ctrl : upcomingMeetingCount

break Fehler bei der Ermittlung der Kennzahlen
    Ctrl --> Page : error
    Page --> Employee : Fehlermeldung, erneutes Laden möglich
end

Ctrl -> Animal : getLatestAnimalsByShelter(shelterId)
Animal --> Ctrl : latestAnimals

alt Tierprofile vorhanden
    Ctrl -> Picture : getCardPictures(animalIds)
    Picture --> Ctrl : cardPictures
else Keine Tierprofile vorhanden
    Ctrl -> Ctrl : useEmptyAnimalList()
end

break Fehler bei der Ermittlung der Tierprofile
    Ctrl --> Page : error
    Page --> Employee : Fehlermeldung, erneutes Laden möglich
end

Ctrl --> Page : dashboardData
Page --> Employee : Dashboard anzeigen

opt Wechsel zu Tierprofilen oder Terminverwaltung
    Employee -> Page : navigate(UC-03 | UC-04)
    Page --> Employee : Weiterleitung zum Ziel
end
@enduml